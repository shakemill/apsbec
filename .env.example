# ─── Vercel Blob Storage ──────────────────────────────────────────────────────
# Obtenir depuis : Vercel Dashboard → Storage → Blob → votre store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ─── Session admin (cookie httpOnly) ─────────────────────────────────────────
# Chaîne aléatoire longue — générer avec : openssl rand -base64 32
SESSION_SECRET=remplacez_par_une_chaine_aleatoire_longue

# ─── Code admin initial ───────────────────────────────────────────────────────
# Utilisé uniquement à la PREMIÈRE visite de /admin/config pour créer le hash.
# Changez-le depuis l'interface /admin/config ensuite.
ADMIN_CODE_INIT=APSBEC2024
